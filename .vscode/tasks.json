{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run starmap",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": ["run"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Test starmap",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": ["test"],
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
